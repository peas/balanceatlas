---
// "Sobre o evento": what the HandstandFest is (tabs), who makes it, and the FAQ about the festival.
// "Quem faz" is Paulo's own text (04/11/2026), lightly edited; do not add biography that he did not give.
import FestLayout from '../../layouts/FestLayout.astro';
import SobreTabs from '../../components/fest/SobreTabs.astro';
import { days, levelName, tracks } from '../../festival/home-content';
import EngravingArtwork from '../../festival/EngravingArtwork';
import { TICKETS, TICKETS_ALVO, QUANDO, faqFest } from '../../festival/data';
---

<FestLayout title="Sobre o evento · 1º HandstandFest" description="Quem faz o 1º HandstandFest, por que ele existe, para quem é e as perguntas mais comuns.">
  <header class="page-head claro">
    <p class="kicker">1º HandstandFest · São Paulo · {QUANDO}</p>
    <h1>Sobre <span>o evento</span></h1>
    <p class="lead">O primeiro festival brasileiro dedicado à parada de mão. Três dias de aula, treino e gente que gosta de ficar de cabeça para baixo.</p>
  </header>

  <div class="page-section">
    <SobreTabs />
  </div>

  <!-- SCHEDULE -->
  <section class="schedule wrap" id="grade" data-tabs>
    <div class="section-head">
      <h2 class="display" data-reveal>Grade</h2>
      <p class="note"><span class="pill">Provisória</span> Ainda estamos ajustando as aulas e os professores de cada bloco. O que já vale: <strong>4 blocos por dia</strong>, parada de mão sempre na sua turma, com professor e professores assistentes, e um fio que começa na base da sexta e termina no jam de domingo.</p>
    </div>
    <div class="days" role="tablist" aria-label="Dias da programação">
      {days.map((d, i) => (
        <button role="tab" class="day" data-tab={d.id} aria-selected={i === 0 ? 'true' : 'false'}>
          <span>{d.label}</span><b>{d.date}</b><em>{d.arc}</em>
        </button>
      ))}
    </div>
    <div class="legend">
      {(Object.keys(levelName) as (keyof typeof levelName)[]).map((l) => <span class={`lvl lvl-${l}`}>{levelName[l]}</span>)}
    </div>
    {days.map((d, i) => (
      <div class="grid-day" data-panel={d.id} hidden={i !== 0}>
        <div class="grid-row grid-head">
          <span></span>{tracks.map((r) => <span>{r}</span>)}
        </div>
        {d.rows.map((row) => (
          <div class="grid-row">
            <span class="time">{row.time}</span>
            {'all' in row ? (
              <span class:list={['cell', 'all', { pause: row.pause }]}>{row.all}</span>
            ) : (
              row.tracks.map((s) => (
                <span class={`cell lvl-${s.level}`}>
                  <small>{levelName[s.level]}</small>{s.t}
                </span>
              ))
            )}
          </div>
        ))}
      </div>
    ))}
  </section>

  <!-- QUEM FAZ -->
  <section class="quem-wrap wrap" id="quem-faz">
    <div class="section-head">
      <h2 class="display" data-reveal>Quem faz</h2>
      <p class="note">O festival nasceu de duas pessoas que treinam juntas.</p>
    </div>
    <div class="quem">
      <div class="moldura"><figure class="quem-photo" data-reveal>
        <img src="/festival/seg-1.webp" alt="Dois praticantes em parada de mão num parque" loading="lazy" />
      </figure></div>
      <div class="quem-cards">
        <article class="quem-card" data-reveal>
          <h3>Gabriel Agustin</h3>
          <p>A ideia veio dele, depois de uma experiência incrível na Argentina. É artista de acro, yoga e parada de mão.</p>
          <a class="chip" href="https://www.instagram.com/agustin_melesi/" target="_blank" rel="noopener">@agustin_melesi</a>
        </article>
        <article class="quem-card" data-reveal>
          <h3>Paulo Silveira</h3>
          <p>Professor e programador, pratica handstand há 9 anos. Aprendeu dentro da calistenia com o professor <a href="https://www.instagram.com/andrejuda/" target="_blank" rel="noopener">Andre Juda</a> e hoje treina junto com o Gabriel.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="practice-art wrap" aria-labelledby="practice-title">
    <div class="practice-art-image"><EngravingArtwork figure="straddle" paint="sweep" background="green" /></div>
    <div class="practice-art-copy">
      <p class="kicker">Handstand = parada de mão</p>
      <h2 id="practice-title">Sobre handstand</h2>
      <a class="cta cta-ink" href="/festival/handstand/">Conheça a prática <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq wrap" id="perguntas">
    <div class="section-head">
      <h2 class="display" data-reveal>Perguntas</h2>
      <p class="note">Sobre o festival. As dúvidas sobre a prática estão em <a href="/festival/handstand/#perguntas">Sobre handstand</a>.</p>
    </div>
    <div class="faq-list">
      {faqFest.map((f) => (
        <details data-reveal><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
    <a class="cta cta-ink" href={TICKETS} target={TICKETS_ALVO} rel="noopener">Garanta sua vaga <span aria-hidden="true">→</span></a>
  </section>
</FestLayout>

<style>
  .practice-art { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1fr); gap: clamp(28px, 6vw, 80px); align-items: center; padding-block: clamp(36px, 6vw, 72px); }
  .practice-art-image { max-width: 420px; width: 100%; }
  .practice-art-copy h2 { font: 900 clamp(32px, 5vw, 64px)/1 var(--display); font-stretch: 125%; text-transform: uppercase; margin: 18px 0 28px; }
  @media (max-width: 640px) { .practice-art { grid-template-columns: 1fr; } .practice-art-image { max-width: 340px; margin-inline: auto; } .practice-art-copy { text-align: center; } }
</style>
