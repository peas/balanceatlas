---
import {clips,controls,looks} from '../../festival/engraving/settings.mjs';
---
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>Handstand Life · laboratório de hachura</title></head>
<body><main>
<header><a href="/festival/instagram/">← Estúdio de Instagram</a><span>ESTUDO / 01</span></header>
<div class="intro"><p class="eyebrow">HANDSTAND LIFE · NOME EM ESTUDO</p><h1>O movimento.<br/><em>Outro traço.</em></h1><p>Dois vídeos, dois tratamentos. Ajuste a tinta enquanto o corpo se move. Seus ajustes ficam guardados neste navegador; nenhum padrão foi escolhido ainda.</p></div>
<div class="toolbar"><button id="toggle-all">Pausar os dois</button><button id="download">Baixar ajustes</button><label class="file-button">Carregar ajustes<input id="import" type="file" accept="application/json"/></label><span id="notice" role="status"></span></div>
<div class="panels">{[0,1].map(i=><section class="panel" data-panel={i}>
  <div class="panel-title"><span>ESTUDO {i?'B':'A'}</span><h2>{i?'Verde & cor':'Grafite no papel'}</h2></div>
  <div class="workspace">
  <div class="media-column"><div class="screen"><video muted loop playsinline preload="auto" aria-label={clips[i].name}></video><canvas aria-label={`Prévia com hachura ${i?'B':'A'}`}></canvas><span class="badge">HACHURA CONTÍNUA</span></div>
  <div class="transport"><button class="pause">Pausar</button><button class="original" aria-pressed="false">Ver original</button><button class="still">Salvar imagem</button></div><p class="status" role="status">Carregando vídeo…</p></div>
  <div class="settings"><label>Vídeo<select class="clip">{clips.map(c=><option value={c.id} selected={c.id===clips[i].id}>{c.name}</option>)}</select></label><p class="source-note">{clips[i].detail}</p>
  <label>Ponto de partida<select class="look">{Object.entries(looks).map(([key,l])=><option value={key} selected={key===(i?'green':'graphite')}>{l.name}</option>)}</select></label>
  {controls.map(([key,label,min,max,step])=><label class="slider"><span>{label}<output data-output={key}></output></span><input type="range" data-key={key} aria-label={`${label} ${i?'B':'A'}`} min={min} max={max} step={step}/></label>)}
  <div class="colors"><label>Tinta<input type="color" data-key="ink" aria-label={`Cor da tinta ${i?'B':'A'}`}/></label><label>Papel<input type="color" data-key="paper" aria-label={`Cor do papel ${i?'B':'A'}`}/></label></div>
  <div class="actions"><button class="copy">Copiar para {i?'A':'B'}</button><button class="reset">Recomeçar {i?'B':'A'}</button></div>
  </div></div>
</section>)}</div>
<footer><strong>Para demonstrar e narrar.</strong><p>Este estudo aplica contorno e hachura ao vídeo inteiro, preservando a pose filmada. Não remove o fundo e não é a mesma gravura anatômica das imagens desenhadas. Para exercícios, vamos escolher o tratamento que deixa mãos, articulações e transições mais fáceis de ler.</p><p>As prévias estão sem áudio. Uma futura narração e suas legendas entram em camadas separadas. Você pode pausar um quadro e comparar o original antes de escolher.</p></footer>
</main><script>import {initLab} from '../../festival/engraving/lab.mjs';initLab();</script></body></html>
<style>
:global(*){box-sizing:border-box} :global(body){margin:0;background:#f3eddf;color:#193e32;font-family:system-ui,sans-serif}main{max-width:1580px;margin:auto;padding:28px clamp(18px,4vw,64px) 60px}header{display:flex;justify-content:space-between;gap:20px;font-size:13px}a{color:inherit;text-decoration:none}.eyebrow,header span,.panel-title>span{font-size:11px;font-weight:700;letter-spacing:.16em}.intro{padding:32px 0 24px;display:grid;grid-template-columns:1fr 1fr;gap:0 40px;align-items:end}.eyebrow{grid-column:1/-1}h1{font-size:clamp(36px,4.3vw,66px);line-height:1.03;letter-spacing:-.045em;margin:8px 0}h1 em{font-family:Georgia,serif;color:#a66c28;font-weight:400}.intro>p:last-child{max-width:440px;line-height:1.6;margin-bottom:5px}.toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:14px 0 28px}button,.file-button{font:inherit;font-size:13px;font-weight:600;color:inherit;background:transparent;border:1px solid #193e3245;padding:10px 13px;border-radius:5px;cursor:pointer}button:hover,.file-button:hover{background:#e2d8c3}button:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #b67c31;outline-offset:3px}#toggle-all{background:#193e32;color:#fff}.file-button input{display:none}#notice{font-size:12px}.panels{display:grid;grid-template-columns:1fr 1fr;gap:24px}.panel{min-width:0;border-top:2px solid #193e32}.panel-title{padding:18px 0;display:flex;align-items:baseline;gap:16px}.panel-title h2{margin:0;font-size:23px;letter-spacing:-.035em}.workspace{display:grid;grid-template-columns:minmax(0,1fr) minmax(180px,.8fr);gap:18px}.screen{position:relative;background:#193e32;aspect-ratio:9/16;overflow:hidden;border-radius:3px}.screen video,.screen canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}.screen canvas{opacity:0}.screen.ready canvas{opacity:1}.screen.original canvas{opacity:0}.badge{position:absolute;bottom:10px;left:10px;background:#f3eddf;color:#193e32;padding:5px 7px;font-size:9px;letter-spacing:.06em;font-weight:700;pointer-events:none}.transport{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}.transport button{font-size:11px;padding:8px}.transport [aria-pressed=true]{background:#193e32;color:#f3eddf}.status,.source-note{font-size:11px;line-height:1.5;opacity:.75;margin:8px 0 14px}.settings label{display:block;font-size:12px;font-weight:600}select{font:inherit;width:100%;margin-top:6px;padding:8px 6px;color:#193e32;background:#faf7ef;border:1px solid #193e3240;border-radius:4px}.slider{margin:13px 0}.slider span{display:flex;justify-content:space-between;gap:5px}output{font-variant-numeric:tabular-nums;font-weight:400}input[type=range]{width:100%;accent-color:#9c6929;margin:9px 0 0;cursor:pointer}.colors{display:flex;gap:15px;margin-top:15px}.colors label{display:flex;align-items:center;gap:7px}input[type=color]{width:35px;height:28px;padding:0;border:0;cursor:pointer}.actions{display:flex;gap:6px;margin-top:16px}.actions button{font-size:11px;padding:8px}footer{border-top:1px solid #193e3230;margin-top:40px;padding-top:25px;max-width:740px;line-height:1.6}footer p{font-size:13px}button:disabled{opacity:.4;cursor:wait}@media(max-width:1100px){.workspace{grid-template-columns:1fr}.media-column{max-width:330px;width:100%;margin:auto}.settings{display:grid;grid-template-columns:1fr 1fr;column-gap:18px}.settings>label:first-child,.settings>.source-note,.settings>.actions{grid-column:1/-1}.settings>label:nth-child(3){grid-column:1/-1}.panel-title h2{font-size:21px}}@media(max-width:620px){.intro{display:block}.intro>p:last-child{font-size:14px}.settings{grid-template-columns:1fr}.settings>label,.settings>.source-note,.settings>.actions{grid-column:1}.panel-title{display:block}.panel-title>span{display:block;margin-bottom:8px}.intro{padding-top:24px}.panel-title{padding-top:16px}main{padding-top:20px}}
@media(max-width:520px){.panels{grid-template-columns:1fr;gap:32px}.settings{grid-template-columns:1fr 1fr}.settings>label:first-child,.settings>.source-note,.settings>.actions,.settings>label:nth-child(3){grid-column:1/-1}.settings>.slider{grid-column:auto}}
</style>
