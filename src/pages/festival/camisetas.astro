---
import FestLayout from '../../layouts/FestLayout.astro';
import HFSelo from '../../components/fest/HFSelo.astro';
const proposals = [
  { id: '01', name: 'O clássico', tag: 'MINHA ESCOLHA', description: 'HF pequeno na frente. Nas costas, o nome em três linhas e uma parada de mão de perfil. Uma camiseta discreta de frente, reconhecível de costas.', front: 'Selo no peito · cerca de 6 cm', back: 'Nome + silhueta · cerca de 25 cm', inks: 'Creme + amarelo', note: 'O nome tem presença; a silhueta deixa claro o que nos reúne.' },
  { id: '02', name: 'Em linha', tag: 'MAIS SILÊNCIO', description: 'O corpo vira o centro da estampa. Uma linha longa, pés apontados e braços estendidos; o nome acompanha na base. O HF fica perto da nuca.', front: 'Silhueta + nome · cerca de 27 cm de altura', back: 'Selo + assinatura · cerca de 11 cm', inks: 'Creme + amarelo', note: 'Mais espaço vazio, menos marca. Para quem quer vestir a prática.' },
  { id: '03', name: 'Corpo e letra', tag: 'MAIS PRESENÇA', description: 'HAND / STAND / FEST ocupa a frente, como no site. A silhueta faz a barra vertical e o pequeno HF assina o conjunto. Nas costas, uma versão compacta.', front: 'Composição frontal · cerca de 28 cm', back: 'Assinatura alta · cerca de 12 cm', inks: 'Amarelo + creme', note: 'A mais próxima da linguagem do festival, sem virar camiseta de uma edição.' },
];
---
<FestLayout stickyNav={false} title="Camisetas · HandstandFest" description="Três propostas atemporais de camiseta HandstandFest: HF, tipografia e uma parada de mão de perfil.">
  <main class="shirts">
    <nav class="shirt-nav" aria-label="Estudos de camiseta">
      <a href="/festival/" class="shirt-brand"><HFSelo simples /> HandstandFest</a>
      <div><a href="/festival/instagram2/">Instagram ↗</a><a href="/festival/">O festival ↗</a></div>
    </nav>
    <header class="shirt-intro">
      <p class="eyebrow">ESTUDO DE CAMISETAS / HF</p>
      <div class="intro-grid"><h1>PARA USAR.<br /><span>SEM DATA.</span></h1><p>O nome, o gesto e a marca.<br />Três caminhos para uma camiseta que continua fazendo sentido depois do encontro.</p></div>
      <div class="materials"><span><i></i> Verde · referência Nori Green</span><span>Creme + amarelo na estampa</span><span>Frente e costas, lado a lado</span></div>
    </header>

    {proposals.map(p => <section class="proposal" id={`proposta-${p.id}`} aria-labelledby={`title-${p.id}`}>
      <header class="proposal-header"><div class="proposal-number">{p.id}</div><div><p class="eyebrow">{p.tag}</p><h2 id={`title-${p.id}`}>{p.name}</h2></div><p class="proposal-copy">{p.description}</p></header>
      <div class="garments">
        {(['front','back'] as const).map(side => <figure>
          <figcaption><strong>{side==='front'?'FRENTE':'COSTAS'}</strong><span>{side==='front'?p.front:p.back}</span></figcaption>
          <picture><source srcset={`/festival/camisetas/${p.id}-${side}.webp`} type="image/webp" /><img src={`/festival/camisetas/${p.id}-${side}.svg`} width="600" height="720" loading={p.id==='01'?'eager':'lazy'} alt={`Proposta ${p.id}, ${side==='front'?'frente':'costas'} da camiseta verde: ${side==='front'?p.front:p.back}`} /></picture>
          <a class="art-link" href={`/festival/camisetas/${p.id}-${side}-art.svg`} download>Baixar arte vetorial {side==='front'?'da frente':'das costas'} ↓</a>
        </figure>)}
      </div>
      <footer class="proposal-footer"><span>{p.note}</span><span>{p.inks} · sem data, ano ou cidade</span></footer>
    </section>)}

    <section class="details" aria-labelledby="detail-title">
      <div class="pose"><img src="/festival/camisetas/handstand-profile.svg" alt="Silhueta estilizada em parada de mão de perfil, pernas juntas e braços estendidos." width="110" height="400" /></div>
      <div><p class="eyebrow">O GESTO PERMANECE</p><h2 id="detail-title">Uma linha.<br />Um corpo inteiro.</h2><p>A silhueta foi desenhada para esta proposta: perfil, pernas juntas, pés apontados e quadril sobre os ombros e as mãos. O corpo inteiro aparece; a cabeça acompanha a linha dos braços.</p><a href="/festival/camisetas/handstand-profile.svg" download>Baixar silhueta em SVG ↓</a></div>
      <aside><h3>Base e acabamento</h3><p>Estudos ilustrados sobre uma camiseta de gola redonda. O <a href="https://insiderstore.com/products/men-tech-t-shirt" target="_blank" rel="noopener noreferrer">Nori Green da Tech T-Shirt Insider</a> é a referência de cor; estes desenhos não são fotos oficiais.</p><p>O verde e as medidas são aproximações para comparar as estampas. Antes de produzir, conferir a amostra da camiseta e testar a aplicação da tinta no tecido. Sem impressão retangular de fundo: o verde é a própria camiseta.</p></aside>
    </section>
  </main>
</FestLayout>
<style>
  .shirts{--shirt:#34463c;max-width:1320px;margin:0 auto;padding:0 clamp(20px,5vw,72px);color:var(--stage)}
  .shirt-nav{display:flex;align-items:center;justify-content:space-between;padding:26px 0 48px;gap:24px;font:12px var(--mono)}
  .shirt-brand{display:flex;align-items:center;gap:10px;font-weight:700}.shirt-brand :global(.selo){width:44px}
  .shirt-nav>div{display:flex;gap:30px}.shirts a{color:inherit;text-underline-offset:5px}.shirt-nav a{text-decoration:none}
  .shirt-intro{padding:25px 0 0}.eyebrow{font:11px/1.5 var(--mono);letter-spacing:.13em;margin:0 0 15px}
  .intro-grid{display:grid;grid-template-columns:1.5fr 1fr;align-items:end;gap:50px}.intro-grid h1{font:900 clamp(40px,6vw,82px)/.94 var(--display);font-stretch:125%;letter-spacing:-.055em;margin:0}.intro-grid h1 span{color:#68766a}.intro-grid p{font-size:18px;line-height:1.6;max-width:34ch;margin:0 0 5px}
  .materials{display:flex;gap:32px;flex-wrap:wrap;border-top:1px solid #c8cbbb;border-bottom:1px solid #c8cbbb;padding:19px 0;margin-top:42px;font:11px var(--mono)}.materials span{display:flex;align-items:center;gap:9px}.materials i{width:17px;height:17px;border-radius:50%;background:var(--shirt)}
  .proposal{padding-top:65px;scroll-margin-top:25px}.proposal-header{display:grid;grid-template-columns:60px 1fr 1fr;gap:25px;align-items:start}.proposal-number{font:900 38px/1 var(--display);color:#7b8675}.proposal-header .eyebrow{margin-bottom:7px}.proposal h2,.details h2{font:900 clamp(30px,3.5vw,48px)/1 var(--display);font-stretch:125%;letter-spacing:-.04em;margin:0}.proposal-copy{font:16px/1.65 var(--body);max-width:46ch;margin:0}
  .garments{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:30px;background:#ebe9df;padding:24px 20px 18px}.garments figure{min-width:0;margin:0}.garments figure+figure{border-left:1px solid #d4d8c9;padding-left:20px}.garments figcaption{display:flex;justify-content:space-between;gap:12px;font:10px/1.5 var(--mono);padding:0 15px}.garments figcaption span{color:#68766a;text-align:right}.garments img{display:block;width:100%;height:auto}.art-link{display:block;text-align:center;font:11px var(--mono);padding:10px}.proposal-footer{display:flex;justify-content:space-between;gap:30px;border-bottom:1px solid #c8cbbb;padding:19px 0;font:12px/1.6 var(--body)}.proposal-footer span:last-child{font:10px/1.6 var(--mono);white-space:nowrap;color:#68766a}
  .details{display:grid;grid-template-columns:.45fr 1fr 1fr;gap:55px;align-items:center;padding:90px 0 100px}.pose{padding:30px;background:var(--stage);text-align:center}.pose img{max-height:310px;width:auto;max-width:100%}.details h2{font-size:38px}.details p{font:15px/1.7 var(--body)}.details .eyebrow{font:11px var(--mono)}.details h3{font:700 13px var(--mono);margin-top:0}.details a{font-size:13px}.details aside{border-left:1px solid #c8cbbb;padding-left:30px}
  @media(max-width:800px){.shirt-nav{font-size:10px;padding-bottom:25px}.shirt-nav>div{gap:12px}.intro-grid{grid-template-columns:1fr;gap:24px}.intro-grid p{font-size:16px;max-width:40ch}.materials{gap:15px;margin-top:28px;font-size:10px}.proposal{padding-top:42px}.proposal-header{grid-template-columns:36px 1fr;gap:16px}.proposal-copy{grid-column:2;font-size:15px}.proposal-number{font-size:28px}.garments{padding:18px 0 15px;gap:0}.garments figure+figure{padding-left:0}.garments figcaption{display:block;font-size:9px;padding:0 12px;min-height:60px}.garments figcaption span{display:block;text-align:left;margin-top:5px;max-width:22ch}.art-link{font-size:9px;line-height:1.6;padding:10px 8px}.proposal-footer{display:block;font-size:12px}.proposal-footer span{display:block}.proposal-footer span:last-child{margin-top:9px;white-space:normal}.details{grid-template-columns:80px 1fr;gap:25px;padding:55px 0}.pose{padding:16px}.pose img{height:230px}.details h2{font-size:28px}.details aside{grid-column:1/-1;border:0;border-top:1px solid #c8cbbb;padding:20px 0 0}.details p{font-size:14px}}
  @media(max-width:460px){.garments{grid-template-columns:1fr;gap:20px}.garments figure+figure{border-left:0;border-top:1px solid #d4d8c9;padding-top:22px}.garments figcaption{display:flex;min-height:0;align-items:center}.garments figcaption span{margin:0;text-align:right}.garments img{max-width:420px;margin:auto}.art-link{font-size:11px}.shirt-brand{font-size:0}.shirt-nav>div{font-size:10px}.intro-grid h1{font-size:40px}}
</style>
