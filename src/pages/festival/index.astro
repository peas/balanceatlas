---
// 1º HandstandFest — standalone festival page (pt-BR), own visual identity.
// Hidden preview: noindex, not linked from the nav.
// Festival media lives in public/festival/ (no R2 token for media-handstand on this machine yet);
// retreat photos come straight from R2. Hero and teacher are Remotion compositions (src/festival/).
import FestLayout from '../../layouts/FestLayout.astro';
import FestNav from '../../components/fest/FestNav.astro';
import FestPlayer from '../../festival/FestPlayer';
import HFSelo from '../../components/fest/HFSelo.astro';
import ArtGesture from '../../components/fest/ArtGesture.astro';
import { TICKETS, TICKETS_ALVO, FEST, VENDA } from '../../festival/data';

import { LOTES, VAGAS, MAPS_Q, MAPS_PLACE, lineup, facts } from '../../festival/home-content';

---

<FestLayout>
  <!-- HERO -->
  <header class="hero claro">
    <FestNav home />
    <div class="hero-title">
      <p class="kicker">Festival de parada de mão · São Paulo</p>
      <h1 class="logo" aria-label="1º HandstandFest">
        <span class="hero-first-line"><b class="edition" aria-hidden="true">1º</b><span class="l1">Hand</span></span>
        <span class="l2">stand</span>
        <span class="l3">Fest</span>
      </h1>
    </div>
    <div class="hero-info">
      <div class="hero-facts">
        <p class="dates">Sex {FEST.dias[0]} · Sáb {FEST.dias[1]} · Dom {FEST.dias[2]} de {FEST.mes}</p>
        <p class="place"><span>São Paulo</span> Brasil · 2027</p>
      </div>
      <div class="hero-actions">
        <a class="cta" href="#ingressos">Garantir vaga <span aria-hidden="true">→</span></a>
        <p class="lote-info">1º lote <span data-venda="aberto">abre {VENDA.dia}</span> · R$ 490 · 10 vagas</p>
      </div>
    </div>
    <figure class="hero-media moldura">
      <HFSelo class="hero-selo" />
      <div class="stage">
        <img src="/festival/seg-1.webp" alt="Agustin Melesi em parada de mão" />
        <FestPlayer client:only="react" comp="hero" />
      </div>
    </figure>
  </header>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[0, 1].map(() => facts.map((f) => <span>{f}<em>■</em></span>))}
    </div>
  </div>

  <!-- ABOUT -->
  <section class="about wrap">
    <div class="about-art" data-reveal><ArtGesture pose="straddle" /></div>
    <div class="about-text">
    <h2 class="display" data-reveal>Três dias de aulas, treinos e gente que gosta de ficar de cabeça para baixo.</h2>
    <div class="about-cols">
      <p>A primeira edição é para quem já pratica parada de mão e também para quem quer conhecer e entrar nessa prática: quem chega pela calistenia, pelo yoga, pela dança, pelo movimento ou só pela curiosidade.</p>
    </div>
    </div>
  </section>

  <!-- TEACHER -->
  <section class="teacher grain" id="professores">
    <div class="wrap teacher-grid">
      <div class="poster">
        <div class="stage">
          <img src="/festival/teacher.webp" alt="Agustin Melesi" loading="lazy" />
          <FestPlayer client:visible comp="teacher" />
        </div>
      </div>
      <div class="teacher-info" data-reveal>
        <p class="kicker">Professor convidado</p>
        <h2 class="teacher-name"><span>Agustin</span> Melesi</h2>
        <a class="chip" href="https://www.instagram.com/agustin_melesi/" target="_blank" rel="noopener">@agustin_melesi</a>
        <ul class="tags">
          <li>Handstand</li><li>Acompanhamento 1:1</li><li>Acroyoga</li><li>Portês acrobáticos</li>
        </ul>
        <p class="source">Áreas segundo o perfil dele no <a href="https://www.instagram.com/agustin_melesi/" target="_blank" rel="noopener">Instagram</a>.</p>
      </div>
    </div>
    <div class="wrap lineup">
      <h3 class="lineup-title" data-reveal>Também na escalação</h3>
      <div class="lineup-grid">
        {lineup.map((t) => (
          <article class="story-card" data-reveal>
            <div class="story">
              {t.poster.img && <img src={t.poster.img} alt={`${t.poster.first} ${t.poster.last}`} loading="lazy" style={`object-position: ${t.poster.focus ?? 'center'}`} />}
              <FestPlayer client:visible comp="poster" props={t.poster} />
            </div>
            {t.url ? <a class="chip" href={t.url} target="_blank" rel="noopener">{t.poster.handle}</a> : <span class="chip">{t.poster.first} {t.poster.last}</span>}
            {t.quote && <blockquote>“{t.quote}”</blockquote>}
            <p class="source">{t.where}{t.quote && <> · <a href={t.source} target="_blank" rel="noopener">fonte</a></>}</p>
          </article>
        ))}
      </div>
      <p class="lineup-more" data-reveal>Mais nomes em breve.</p>
    </div>
  </section>

  <!-- The detailed schedule lives on the event page; retain the old home anchor. -->
  <section class="schedule wrap" id="grade">
    <h2 class="display" data-reveal>Programação</h2>
    <a class="cta cta-ink" href="/festival/sobre/#grade">Veja a grade dos três dias <span aria-hidden="true">→</span></a>
    <p class="cta-note">Programação provisória, com aulas e professores em definição.</p>
  </section>

  <!-- LEVELS -->
  <section class="levels wrap">
    <article class="level-card lvl-basico" data-reveal>
      <h3>Básico</h3>
      <p><strong>Você treina na parede e ainda não segura o livre.</strong> Linha, chute, saída segura e os primeiros segundos sem a parede.</p>
    </article>
    <article class="level-card lvl-inter" data-reveal>
      <h3>Intermediário</h3>
      <p><strong>Você segura uns 10 segundos no livre, de forma consistente</strong> (30 é o ideal). Equilíbrio, formas, entradas e tempo.</p>
    </article>
    <article class="level-card lvl-avancado" data-reveal>
      <h3>Avançado</h3>
      <p><strong>Livre com folga.</strong> Press, one arm e formas, na mesma turma do intermediário, com trabalho de flexibilidade e força à tarde.</p>
    </article>
  </section>

  <!-- MORE: the two subpages -->
  <section class="more wrap">
    <a class="more-card" href="/festival/sobre/" data-reveal><span>Sobre o evento</span><p>Quem faz, por que existe, para quem é e as perguntas mais comuns.</p><b aria-hidden="true">→</b></a>
    <a class="more-card alt" href="/festival/handstand/" data-reveal><span>Sobre handstand</span><p>A prática, fotos de encontros pelo mundo e outros workshops e retiros.</p><b aria-hidden="true">→</b></a>
  </section>

  <!-- VENUE -->
  <section class="venue wrap" id="local">
    <div class="section-head">
      <h2 class="display" data-reveal>Onde</h2>
      <p class="note">Butantã · São Paulo</p>
    </div>
    <div class="venue-grid">
      <div class="venue-photos">
        <!-- our own footage of 04/11/2026: the tour is the Instagram piece "O lugar" without its closing card -->
        <div class="venue-tour" data-reveal>
          <FestPlayer client:only="react" comp="lugar" />
          <span class="vbadge" aria-hidden="true"><i>▶</i>tour</span>
        </div>
        <img src="/festival/ig/tv-sala-vidro.webp" alt="Sala de vidro do Trapézio Voador, com piso de madeira" loading="lazy" data-reveal />
        <img src="/festival/ig/tv-palco-luzes.webp" alt="Palco do Trapézio Voador, com tecidos e refletores" loading="lazy" data-reveal />
        <img src="/festival/ig/tv-fachada.webp" alt="Fachada do Trapézio Voador e a arena externa" loading="lazy" data-reveal />
      </div>
      <div class="venue-info">
        <h3>Trapézio Voador</h3>
        <blockquote>Um espaço amplo, confortável, para as práticas do handstand e além.</blockquote>
        <p>R. Alvarenga, 150 · Jardim Guedala<br />Nas proximidades da Estação Butantã do metrô (linha 4-amarela)</p>
        <div class="venue-stories">
          {['/festival/venue-3.webp', '/festival/venue-4.webp'].map((src) => (
            <a class="mini-story" href="https://www.instagram.com/trapeziovoador/" target="_blank" rel="noopener" data-reveal>
              <span class="mini-bars" aria-hidden="true"><b></b><b></b></span>
              <span class="mini-handle">@trapeziovoador</span>
              <img src={src} alt="Trapézio Voador no Instagram" loading="lazy" />
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="map" data-reveal>
      <iframe
        src={`https://www.google.com/maps/embed?origin=mfe&pb=!1m3!2m1!1s${MAPS_Q}!6i15`}
        title="Mapa: Trapézio Voador"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
      <a class="chip map-link" href={MAPS_PLACE} target="_blank" rel="noopener">Como chegar <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- TICKETS -->
  <section class="signup grain" id="ingressos">
    <div class="wrap signup-inner">
      <div class="signup-art" aria-hidden="true"><ArtGesture pose="stag" /></div>
      <p class="kicker">Ingressos · {FEST.dias[0]} — {FEST.dias[2]} · {FEST.mes} · {FEST.ano}</p>
      <h2 class="display" data-reveal>Três lotes. Começa pelo primeiro.</h2>
      <div class="lotes">
        {LOTES.map((l) => (
          <article class:list={['lote', l.state]} data-reveal>
            <span class="lote-bar" aria-hidden="true"><b></b></span>
            <p class="lote-n">{l.n}{l.state === 'aberto' && <em><i aria-hidden="true"></i><span data-venda="agora">abre {VENDA.dia}</span></em>}</p>
            <p class="lote-price"><small>R$</small>{l.price}</p>
            <p class="lote-note">{l.note}</p>
          </article>
        ))}
      </div>
      <a class="cta cta-dark" href={TICKETS} target={TICKETS_ALVO} rel="noopener">Garantir vaga no 1º lote <span aria-hidden="true">→</span></a>
      <p class="lote-foot">Passe completo para os 3 dias, {VAGAS} vagas no total. Quando as 10 do 1º lote acabarem, abre o 2º; depois das 35 do 2º, o 3º.</p>
    </div>
  </section>
</FestLayout>
