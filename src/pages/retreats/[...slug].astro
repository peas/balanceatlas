---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { MEDIA_URL } from '../../config';

export async function getStaticPaths() {
  const retreats = await getCollection('retreats');
  return retreats.map((retreat) => ({
    params: { slug: retreat.id },
    props: { retreat },
  }));
}

const { retreat } = Astro.props;
const { Content } = await render(retreat);

const { title, status, coaches, location, dateStart, dateEnd, level, type, heroImage: rawHeroImage, gallery: rawGallery, videos: rawVideos, registrationUrl, venueUrl, highlightQuote, description } = retreat.data;

const heroImage = rawHeroImage ? `${MEDIA_URL}${rawHeroImage}` : undefined;
const gallery = rawGallery?.map((p: string) => `${MEDIA_URL}${p}`);
const videos = rawVideos?.map((v: string) => `${MEDIA_URL}${v}`);

const isUpcoming = status === 'upcoming';
const hasGallery = gallery && gallery.length > 0;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const formatDateShort = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

const days = Math.round((dateEnd.getTime() - dateStart.getTime()) / (1000 * 60 * 60 * 24));

const levelColors: Record<string, string> = {
  beginner: 'bg-teal/15 text-teal-dark',
  intermediate: 'bg-coral/15 text-coral-dark',
  advanced: 'bg-navy/10 text-navy',
};

// For showcase pages, split gallery into grid + carousel
const gridPhotos = hasGallery ? gallery.slice(0, 8) : [];
const carouselPhotos = hasGallery ? gallery.slice(8) : [];

// Find related coaches
const allCoaches = await getCollection('coaches');
const relatedCoaches = allCoaches.filter((c) => coaches.includes(c.id));
---

<BaseLayout title={title} ogImage={heroImage}>
  {hasGallery ? (
    <!-- ═══════════════════════════════════════════ -->
    <!-- SHOWCASE LAYOUT — past retreats with photos -->
    <!-- ═══════════════════════════════════════════ -->

    <Fragment>
      <!-- Full-bleed hero -->
      <section class="relative min-h-[90vh] flex items-end overflow-hidden">
        {heroImage && (
          <img
            src={heroImage}
            alt={title}
            class="absolute inset-0 w-full h-full object-cover"
            loading="eager"
          />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-navy-dark via-navy-dark/50 to-transparent" />

        <div class="relative w-full max-w-7xl mx-auto px-6 pb-16 md:pb-24">
          <div class="flex flex-wrap items-center gap-2 mb-4"
            data-animate style="opacity: 0; transform: translateY(24px);">
            <span class="text-xs font-medium uppercase tracking-wider text-white/60 bg-white/10 backdrop-blur-sm px-3 py-1 rounded-full">
              {type}
            </span>
            {level.map((l) => (
              <span class="text-xs font-medium uppercase tracking-wider text-white/60 bg-white/10 backdrop-blur-sm px-3 py-1 rounded-full">
                {l}
              </span>
            ))}
          </div>

          <h1
            class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-[1.08] max-w-4xl"
            data-animate data-animate-delay="100"
            style="opacity: 0; transform: translateY(24px);"
          >
            {title}
          </h1>

          <div
            class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-white/70 text-sm"
            data-animate data-animate-delay="200"
            style="opacity: 0; transform: translateY(24px);"
          >
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              {formatDateShort(dateStart)} – {formatDateShort(dateEnd)}, {dateEnd.getFullYear()}
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {venueUrl ? (
                <a href={venueUrl} target="_blank" rel="noopener" class="underline decoration-white/30 hover:decoration-white/60 transition-colors">
                  {location.venue ? `${location.venue}, ` : ''}{location.city}, {location.country}
                </a>
              ) : (
                <Fragment>{location.venue ? `${location.venue}, ` : ''}{location.city}, {location.country}</Fragment>
              )}
            </span>
          </div>
        </div>
      </section>

      <!-- Description + stats split -->
      <section class="max-w-7xl mx-auto px-6 py-20">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-12 md:gap-20">
          <div>
            {highlightQuote && (
              <blockquote
                class="text-2xl md:text-3xl font-heading font-semibold text-navy/80 leading-snug mb-8"
                data-animate style="opacity: 0; transform: translateY(24px);"
              >
                "{highlightQuote}"
              </blockquote>
            )}
            <div
              class="prose prose-lg prose-navy max-w-none text-navy/60"
              data-animate data-animate-delay="100"
              style="opacity: 0; transform: translateY(24px);"
            >
              <Content />
            </div>
          </div>

          <!-- Stats sidebar -->
          <div
            class="flex md:flex-col gap-6 md:gap-8 md:w-48 md:pt-2"
            data-animate data-animate-delay="150"
            style="opacity: 0; transform: translateY(24px);"
          >
            <div>
              <p class="font-heading text-4xl font-bold text-coral">{days}</p>
              <p class="text-sm text-navy/40 mt-1">days</p>
            </div>
            <div>
              <p class="font-heading text-4xl font-bold text-coral">{coaches.length}</p>
              <p class="text-sm text-navy/40 mt-1">{coaches.length === 1 ? 'coach' : 'coaches'}</p>
            </div>
            <div>
              <p class="font-heading text-lg font-bold text-navy">
                {location.city}
              </p>
              <p class="text-sm text-navy/40 mt-1">{location.country}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Photo grid -->
      {gridPhotos.length > 0 && (
        <section class="max-w-7xl mx-auto px-6 pb-12">
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 auto-rows-[200px] md:auto-rows-[280px]">
            {gridPhotos.map((photo, i) => {
              const span = i === 0 ? 'col-span-2 row-span-2' : i === 3 ? 'row-span-2' : '';
              return (
                <div
                  class:list={['relative rounded-xl overflow-hidden group', span]}
                  data-animate
                  data-animate-delay={String(Math.min(i * 80, 600))}
                  style="opacity: 0; transform: translateY(24px);"
                >
                  <img
                    src={photo}
                    alt={`${title} photo`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300" />
                </div>
              );
            })}
          </div>
        </section>
      )}

      <!-- Videos -->
      {videos && videos.length > 0 && (
        <section class="max-w-7xl mx-auto px-6 pb-12">
          <h2
            class="font-heading text-2xl md:text-3xl font-bold text-navy mb-6"
            data-animate style="opacity: 0; transform: translateY(24px);"
          >
            Moments
          </h2>
          <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 scrollbar-hide">
            {videos.map((video, i) => (
              <div
                class="flex-none w-48 md:w-56 aspect-[9/16] rounded-xl overflow-hidden snap-center bg-navy/5"
                data-animate
                data-animate-delay={String(Math.min(i * 100, 400))}
                style="opacity: 0; transform: translateY(24px);"
              >
                <video
                  src={video}
                  autoplay
                  muted
                  loop
                  playsinline
                  class="w-full h-full object-cover"
                />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Photo carousel -->
      {carouselPhotos.length > 0 && (
        <section class="pb-20 overflow-hidden">
          <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory px-6 pb-4 scrollbar-hide">
            {carouselPhotos.map((photo) => (
              <div class="flex-none w-72 md:w-96 aspect-[4/3] rounded-xl overflow-hidden snap-center group">
                <img
                  src={photo}
                  alt={`${title} photo`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Coach section -->
      {relatedCoaches.length > 0 && (
        <section class="bg-navy/[0.03] py-20">
          <div class="max-w-7xl mx-auto px-6">
            <h2
              class="font-heading text-2xl md:text-3xl font-bold text-navy mb-8"
              data-animate style="opacity: 0; transform: translateY(24px);"
            >
              {relatedCoaches.length === 1 ? 'Your coach' : 'Your coaches'}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
              {relatedCoaches.map((coach, i) => (
                <a
                  href={`/coaches/${coach.id}`}
                  class="group flex items-center gap-5 bg-white rounded-2xl p-5 shadow-sm hover:shadow-md transition-all"
                  data-animate
                  data-animate-delay={String(i * 100)}
                  style="opacity: 0; transform: translateY(24px);"
                >
                  <div class="w-16 h-16 rounded-xl overflow-hidden shrink-0">
                    {coach.data.photo ? (
                      <img src={`${MEDIA_URL}${coach.data.photo}`} alt={coach.data.name} class="w-full h-full object-cover" />
                    ) : (
                      <div class="w-full h-full bg-gradient-to-br from-teal/20 to-coral/20 flex items-center justify-center">
                        <span class="text-2xl opacity-30">🤸</span>
                      </div>
                    )}
                  </div>
                  <div>
                    <p class="font-heading font-bold text-navy group-hover:text-coral transition-colors">{coach.data.name}</p>
                    <p class="text-sm text-navy/50">{coach.data.location.city}, {coach.data.location.country}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}
    </Fragment>

  ) : (

    <!-- ═══════════════════════════════════════ -->
    <!-- SIMPLE LAYOUT — upcoming / no gallery  -->
    <!-- ═══════════════════════════════════════ -->

    <Fragment>
      <div class="relative">
        {heroImage ? (
          <div class="h-72 md:h-96 overflow-hidden">
            <img src={heroImage} alt={title} class="w-full h-full object-cover" loading="eager" />
            <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/30 to-transparent" />
          </div>
        ) : (
          <div class="h-48 md:h-64 bg-gradient-to-br from-coral/30 to-teal/30" />
        )}
      </div>

      <div class="max-w-4xl mx-auto px-6 -mt-16 relative z-10">
        <div class="bg-white rounded-2xl shadow-xl p-8 md:p-12">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            {isUpcoming && (
              <span class="bg-coral text-white text-xs font-bold px-3 py-1 rounded-full">Upcoming</span>
            )}
            <span class="text-xs font-medium uppercase tracking-wider text-navy/40 bg-navy/5 px-3 py-1 rounded-full">
              {type}
            </span>
            {level.map((l) => (
              <span class={`text-[10px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full ${levelColors[l] ?? ''}`}>
                {l}
              </span>
            ))}
          </div>

          <h1 class="font-heading text-3xl md:text-4xl font-bold text-navy leading-tight">
            {title}
          </h1>

          <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-coral mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="font-semibold text-navy">{formatDate(dateStart)} – {formatDate(dateEnd)}</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-coral mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <div>
                {venueUrl ? (
                  <a href={venueUrl} target="_blank" rel="noopener" class="font-semibold text-navy hover:text-coral transition-colors underline decoration-navy/20">
                    {location.venue ? location.venue : `${location.city}, ${location.country}`}
                  </a>
                ) : (
                  <p class="font-semibold text-navy">
                    {location.venue ? location.venue : `${location.city}, ${location.country}`}
                  </p>
                )}
                {location.venue && <p class="text-navy/50">{location.city}, {location.country}</p>}
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-coral mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <p class="font-semibold text-navy">
                {coaches.map((c) => c.replace(/-/g, ' ').replace(/\b\w/g, (l) => l.toUpperCase())).join(', ')}
              </p>
            </div>
          </div>

          {highlightQuote && (
            <blockquote class="mt-8 pl-5 border-l-4 border-teal text-navy/60 italic">
              "{highlightQuote}"
            </blockquote>
          )}

          <div class="mt-8 prose prose-navy max-w-none">
            <Content />
          </div>

          {isUpcoming && registrationUrl && (
            <div class="mt-10 pt-6 border-t border-navy/10">
              <a
                href={registrationUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 px-8 py-4 bg-coral hover:bg-coral-dark text-white
                       font-medium rounded-full transition-all duration-300"
              >
                Register
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          )}
        </div>
      </div>

      <div class="h-16"></div>
    </Fragment>
  )}
</BaseLayout>

<style>
  [data-animate].is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
