---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MEDIA_URL } from '../config';

const th = `${MEDIA_URL}/images/retreats/thailand-2026`;
const gr = `${MEDIA_URL}/images/retreats/greece-2025`;
const sp = `${MEDIA_URL}/images/retreats/saopaulo-2024`;
const vth = `${MEDIA_URL}/videos/retreats/thailand-2026`;
const vgr = `${MEDIA_URL}/videos/retreats/greece-2025`;
const vsp = `${MEDIA_URL}/videos/retreats/saopaulo-2024`;

// Curated mix of ~45 items: photos + short videos interleaved from all past retreats
// Balance: action shots, social moments, training, scenery — across all three events
const media: { type: 'photo' | 'video'; src: string; alt: string; span?: string }[] = [
  // Row 1 — strong opening
  { type: 'photo', src: `${th}/38.webp`, alt: 'Thailand 2026', span: 'large' },
  { type: 'video', src: `${vsp}/04.mp4`, alt: 'São Paulo 2024', span: 'tall' },
  { type: 'photo', src: `${sp}/106.webp`, alt: 'São Paulo 2024' },
  { type: 'photo', src: `${sp}/103.webp`, alt: 'São Paulo 2024' },

  // Row 2
  { type: 'photo', src: `${sp}/95.webp`, alt: 'São Paulo 2024', span: 'wide' },
  { type: 'photo', src: `${th}/28.webp`, alt: 'Thailand 2026' },
  { type: 'video', src: `${vgr}/04.mp4`, alt: 'Greece 2025' },
  { type: 'photo', src: `${sp}/102.webp`, alt: 'São Paulo 2024', span: 'tall' },

  // Row 3
  { type: 'photo', src: `${gr}/10.webp`, alt: 'Greece 2025', span: 'wide' },
  { type: 'video', src: `${vth}/10.mp4`, alt: 'Thailand 2026' },
  { type: 'photo', src: `${th}/11.webp`, alt: 'Thailand 2026' },
  { type: 'photo', src: `${sp}/55.webp`, alt: 'São Paulo 2024' },

  // Row 4
  { type: 'photo', src: `${th}/14.webp`, alt: 'Thailand 2026' },
  { type: 'photo', src: `${sp}/100.webp`, alt: 'São Paulo 2024', span: 'wide' },
  { type: 'video', src: `${vth}/07.mp4`, alt: 'Thailand 2026', span: 'tall' },
  { type: 'photo', src: `${gr}/05.webp`, alt: 'Greece 2025' },

  // Row 5
  { type: 'photo', src: `${sp}/60.webp`, alt: 'São Paulo 2024' },
  { type: 'photo', src: `${th}/53.webp`, alt: 'Thailand 2026', span: 'wide' },
  { type: 'video', src: `${vsp}/01.mp4`, alt: 'São Paulo 2024' },
  { type: 'photo', src: `${gr}/10.webp`, alt: 'Greece 2025' },

  // Row 6
  { type: 'photo', src: `${gr}/15.webp`, alt: 'Greece 2025', span: 'tall' },
  { type: 'photo', src: `${th}/57.webp`, alt: 'Thailand 2026' },
  { type: 'video', src: `${vth}/09.mp4`, alt: 'Thailand 2026' },
  { type: 'photo', src: `${sp}/70.webp`, alt: 'São Paulo 2024', span: 'wide' },

  // Row 7
  { type: 'photo', src: `${th}/55.webp`, alt: 'Thailand 2026' },
  { type: 'photo', src: `${gr}/19.webp`, alt: 'Greece 2025', span: 'wide' },
  { type: 'video', src: `${vgr}/01.mp4`, alt: 'Greece 2025', span: 'tall' },
  { type: 'photo', src: `${sp}/85.webp`, alt: 'São Paulo 2024' },

  // Row 8
  { type: 'photo', src: `${th}/49.webp`, alt: 'Thailand 2026', span: 'wide' },
  { type: 'photo', src: `${sp}/50.webp`, alt: 'São Paulo 2024' },
  { type: 'video', src: `${vth}/04.mp4`, alt: 'Thailand 2026' },
  { type: 'photo', src: `${gr}/12.webp`, alt: 'Greece 2025' },

  // Row 9
  { type: 'photo', src: `${sp}/90.webp`, alt: 'São Paulo 2024' },
  { type: 'photo', src: `${th}/36.webp`, alt: 'Thailand 2026', span: 'tall' },
  { type: 'video', src: `${vgr}/05.mp4`, alt: 'Greece 2025' },
  { type: 'photo', src: `${sp}/65.webp`, alt: 'São Paulo 2024', span: 'wide' },

  // Row 10
  { type: 'photo', src: `${th}/30.webp`, alt: 'Thailand 2026' },
  { type: 'photo', src: `${gr}/07.webp`, alt: 'Greece 2025' },
  { type: 'video', src: `${vth}/01.mp4`, alt: 'Thailand 2026', span: 'tall' },
  { type: 'photo', src: `${sp}/75.webp`, alt: 'São Paulo 2024', span: 'wide' },

  // Row 11 — closing
  { type: 'photo', src: `${th}/44.webp`, alt: 'Thailand 2026', span: 'wide' },
  { type: 'photo', src: `${gr}/08.webp`, alt: 'Greece 2025' },
  { type: 'photo', src: `${sp}/80.webp`, alt: 'São Paulo 2024' },
  { type: 'video', src: `${vth}/03.mp4`, alt: 'Thailand 2026' },
];
---

<BaseLayout title="Handstand Life" description="Photos and videos from handstand retreats around the world — one continuous visual stream.">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="text-center mb-12">
      <h1
        class="font-heading text-4xl md:text-5xl font-bold text-navy"
        data-animate
        style="opacity: 0; transform: translateY(24px);"
      >
        The Handstand Life
      </h1>
      <p
        class="mt-4 text-lg text-navy/50 max-w-2xl mx-auto"
        data-animate
        data-animate-delay="100"
        style="opacity: 0; transform: translateY(24px);"
      >
        Photos and videos from retreats around the world — one continuous stream of handstand life.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 auto-rows-[200px] md:auto-rows-[250px]">
      {media.map((item, i) => (
        <div
          class:list={[
            'relative rounded-xl overflow-hidden group',
            item.span === 'tall' && 'row-span-2',
            item.span === 'wide' && 'col-span-2',
            item.span === 'large' && 'col-span-2 row-span-2',
          ]}
          data-animate
          data-animate-delay={String(Math.min(i * 40, 600))}
          style="opacity: 0; transform: translateY(24px);"
        >
          {item.type === 'video' ? (
            <video
              src={item.src}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              class="w-full h-full object-cover"
            />
          ) : (
            <img
              src={item.src}
              alt={item.alt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          )}
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300" />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  [data-animate].is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
</style>
