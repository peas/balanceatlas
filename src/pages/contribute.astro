---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    question: "What is Balance Atlas?",
    answer: "A community-driven directory for the global handstand and hand balancing community. We list retreats, intensives, workshops, and coaches from around the world — curated by hand balancers, for hand balancers."
  },
  {
    question: "Who runs this?",
    answer: "This project is maintained by members of the handstand community. It's open source and anyone can contribute by suggesting retreats, coaches, or corrections."
  },
  {
    question: "How can I add a retreat or event?",
    answer: "Open a GitHub Issue with the event info (dates, location, coaches, registration link) and we'll add it. See the contribution cards above for details."
  },
  {
    question: "How can I suggest a coach to be listed?",
    answer: "Same process — open a GitHub Issue or reach out via email. Include their name, city, Instagram handle, website, and a link to their own bio or about page so we can quote them accurately."
  },
  {
    question: "Where do the descriptions and texts come from?",
    answer: "All descriptions are sourced from the coaches' and events' own websites, social media bios, or official materials. We don't write descriptions ourselves — we quote and link to the original source."
  },
  {
    question: "I'd like to remove a photo or my retreat/intensive. How do I do that?",
    answer: "No problem at all. Just send an email to <a href='mailto:paulo.silveira@gmail.com' class='text-coral hover:text-coral-dark underline'>paulo.silveira@gmail.com</a> and we'll take care of it promptly."
  },
  {
    question: "Is this affiliated with any coach or organization?",
    answer: "No. Balance Atlas is an independent community project. We're not affiliated with any specific coach, school, or organization. We list events and coaches as a resource for the community."
  },
  {
    question: "Can I contribute photos or videos from an event I attended?",
    answer: "Yes! If you have photos or videos from a handstand retreat or workshop, we'd love to feature them. Share a Google Photos album link or similar via GitHub Issue or email, and let us know if there are any photos you'd prefer not to include."
  },
  {
    question: "How often is the site updated?",
    answer: "We add new events and coaches as we learn about them. If you notice something missing or outdated, let us know — contributions from the community are what keep this directory useful."
  },
];
---

<BaseLayout title="Contribute" description="Help grow Balance Atlas by adding retreats, coaches, and training spots.">
  <div class="max-w-3xl mx-auto px-6 py-16">
    <h1
      class="font-heading text-4xl md:text-5xl font-bold text-navy"
      data-animate
      style="opacity: 0; transform: translateY(24px);"
    >
      Contribute
    </h1>
    <p
      class="mt-4 text-lg text-navy/50 max-w-2xl"
      data-animate
      data-animate-delay="100"
      style="opacity: 0; transform: translateY(24px);"
    >
      This is a community project — anyone can suggest a retreat, coach, or training spot.
    </p>

    <div
      class="mt-12 space-y-8"
      data-animate
      data-animate-delay="200"
      style="opacity: 0; transform: translateY(24px);"
    >
      <!-- Add a Retreat -->
      <a
        href="https://github.com/peas/balanceatlas/issues/new?template=add-retreat.yml"
        target="_blank"
        rel="noopener"
        class="block bg-white rounded-2xl p-8 shadow-sm border border-navy/5 hover:border-coral/20 hover:shadow-md transition-all"
      >
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-coral/10 rounded-xl flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h3 class="font-heading font-bold text-lg text-navy">Add a Retreat or Workshop</h3>
            <p class="mt-2 text-navy/50">
              Know about an upcoming handstand retreat, intensive, or workshop? Let us know the dates, location, coaches, and a link to register.
            </p>
            <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-coral">
              Open issue on GitHub
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </span>
          </div>
        </div>
      </a>

      <!-- Add a Coach -->
      <a
        href="https://github.com/peas/balanceatlas/issues/new?template=suggest-coach.yml"
        target="_blank"
        rel="noopener"
        class="block bg-white rounded-2xl p-8 shadow-sm border border-navy/5 hover:border-teal/20 hover:shadow-md transition-all"
      >
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-teal/10 rounded-xl flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-teal-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div>
            <h3 class="font-heading font-bold text-lg text-navy">Suggest a Coach</h3>
            <p class="mt-2 text-navy/50">
              Know a great hand balancing coach who should be listed? Share their name, location, social links, and a short description of their style.
            </p>
            <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-teal-dark">
              Open issue on GitHub
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </span>
          </div>
        </div>
      </a>

      <!-- How it works -->
      <div class="bg-navy/[0.03] rounded-2xl p-8">
        <h3 class="font-heading font-bold text-lg text-navy">How it works</h3>
        <ol class="mt-4 space-y-3 text-navy/60">
          <li class="flex gap-3">
            <span class="shrink-0 w-7 h-7 bg-coral/10 text-coral font-bold text-sm rounded-full flex items-center justify-center">1</span>
            <span>Open a GitHub Issue — pick a template and fill in the details.</span>
          </li>
          <li class="flex gap-3">
            <span class="shrink-0 w-7 h-7 bg-coral/10 text-coral font-bold text-sm rounded-full flex items-center justify-center">2</span>
            <span>A maintainer reviews and formats the content.</span>
          </li>
          <li class="flex gap-3">
            <span class="shrink-0 w-7 h-7 bg-coral/10 text-coral font-bold text-sm rounded-full flex items-center justify-center">3</span>
            <span>Your contribution goes live on the site.</span>
          </li>
        </ol>
        <a
          href="https://github.com/peas/balanceatlas"
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-coral hover:text-coral-dark transition-colors"
        >
          Visit our GitHub
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="mt-16">
      <h2
        class="font-heading text-2xl md:text-3xl font-bold text-navy"
        data-animate
        style="opacity: 0; transform: translateY(24px);"
      >
        Frequently Asked Questions
      </h2>
      <div
        class="mt-8 space-y-4"
        data-animate
        data-animate-delay="100"
        style="opacity: 0; transform: translateY(24px);"
      >
        {faqs.map((faq) => (
          <details class="group bg-white rounded-2xl shadow-sm border border-navy/5 overflow-hidden">
            <summary class="flex items-center justify-between gap-4 px-8 py-5 cursor-pointer select-none hover:bg-navy/[0.02] transition-colors">
              <h3 class="font-heading font-semibold text-navy text-base pr-4">{faq.question}</h3>
              <svg class="w-5 h-5 text-navy/30 shrink-0 transition-transform duration-300 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
            </summary>
            <div class="px-8 pb-5 text-navy/60 leading-relaxed">
              <Fragment set:html={faq.answer} />
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- Next steps -->
    <div
      class="mt-12 p-8 bg-navy/[0.03] rounded-2xl text-center"
      data-animate
      style="opacity: 0; transform: translateY(24px);"
    >
      <p class="text-navy/60">
        Looking for practice spots, coaches, or fellow hand balancers near you?
        Check out the <a href="/community" class="text-coral hover:text-coral-dark font-medium underline transition-colors">community page</a> for
        Instagram accounts, resources, and videos from the handstand world.
      </p>
      <a
        href="mailto:paulo.silveira@gmail.com"
        class="mt-4 inline-flex items-center gap-2 text-coral hover:text-coral-dark font-medium transition-colors"
      >
        Have a question? Get in touch
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  [data-animate].is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  details[open] summary {
    border-bottom: 1px solid rgb(15 23 42 / 0.05);
  }
</style>
