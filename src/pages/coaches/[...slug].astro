---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RetreatCard from '../../components/RetreatCard.astro';
import { getCollection, render } from 'astro:content';
import { MEDIA_URL } from '../../config';

export async function getStaticPaths() {
  const coaches = await getCollection('coaches');
  return coaches.map((coach) => ({
    params: { slug: coach.id },
    props: { coach },
  }));
}

const { coach } = Astro.props;
const { Content } = await render(coach);

const { name, photo, location, instagram, website } = coach.data;

// Find retreats for this coach
const allRetreats = await getCollection('retreats');
const coachRetreats = allRetreats
  .filter((r) => r.data.coaches.includes(coach.id))
  .sort((a, b) => b.data.dateStart.getTime() - a.data.dateStart.getTime());
---

<BaseLayout title={name} description={`${name} — handstand coach based in ${location.city}, ${location.country}.`}>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <div class="flex flex-col md:flex-row gap-8 items-start">
      <!-- Photo -->
      <div class="shrink-0">
        {photo ? (
          <img
            src={`${MEDIA_URL}${photo}`}
            alt={name}
            class="w-40 h-40 md:w-56 md:h-56 rounded-2xl object-cover shadow-lg"
          />
        ) : (
          <div class="w-40 h-40 md:w-56 md:h-56 rounded-2xl bg-gradient-to-br from-teal/20 to-coral/20 flex items-center justify-center shadow-lg">
            <span class="text-6xl opacity-30">🤸</span>
          </div>
        )}
      </div>

      <!-- Info -->
      <div class="flex-1">
        <h1 class="font-heading text-3xl md:text-4xl font-bold text-navy">{name}</h1>
        <p class="mt-2 text-navy/50 flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          {location.city}, {location.country}
        </p>

        <div class="mt-4 flex flex-wrap gap-3">
          {instagram && (
            <a
              href={`https://instagram.com/${instagram}`}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-4 py-2 bg-navy/5 hover:bg-navy/10 rounded-full text-sm
                     font-medium text-navy transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
              </svg>
              @{instagram}
            </a>
          )}
          {website && (
            <a
              href={website}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-4 py-2 bg-navy/5 hover:bg-navy/10 rounded-full text-sm
                     font-medium text-navy transition-colors"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              Website
            </a>
          )}
        </div>

        <div class="mt-6 prose prose-navy max-w-none text-navy/70">
          <Content />
        </div>
      </div>
    </div>

    {coachRetreats.length > 0 && (
      <section class="mt-16">
        <h2 class="font-heading text-2xl font-bold text-navy mb-6">
          Retreats with {name.split(' ')[0]}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {coachRetreats.map((retreat, i) => (
            <RetreatCard
              title={retreat.data.title}
              slug={retreat.id}
              status={retreat.data.status}
              coaches={retreat.data.coaches}
              city={retreat.data.location.city}
              country={retreat.data.location.country}
              venue={retreat.data.location.venue}
              dateStart={retreat.data.dateStart}
              dateEnd={retreat.data.dateEnd}
              level={retreat.data.level}
              type={retreat.data.type}
              heroImage={retreat.data.heroImage ? `${MEDIA_URL}${retreat.data.heroImage}` : undefined}
              description={retreat.data.description}
              index={i}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
