// To restore the full site, revert this commit
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Balance Atlas is coming soon. A community-driven directory for hand balancers worldwide." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Sora:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>Balance Atlas — Coming Soon</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'DM Sans', system-ui, sans-serif;
        background: #FFF8F0;
        color: #1B2A4A;
        overflow: hidden;
      }

      .container {
        text-align: center;
        padding: 2rem;
        max-width: 480px;
      }

      .logo {
        font-family: 'Sora', system-ui, sans-serif;
        font-weight: 700;
        font-size: clamp(2rem, 6vw, 3rem);
        letter-spacing: -0.02em;
        line-height: 1.1;
        margin-bottom: 1.5rem;
      }

      .logo span {
        color: #FF6B4A;
      }

      .tagline {
        font-size: 1.125rem;
        color: #1B2A4A99;
        line-height: 1.6;
        margin-bottom: 0.5rem;
      }

      .dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        background: #FF6B4A;
        border-radius: 50%;
        margin: 2rem auto 0;
        animation: pulse 2s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 0.3; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.5); }
      }

      /* Subtle background circles */
      body::before,
      body::after {
        content: '';
        position: fixed;
        border-radius: 50%;
        opacity: 0.06;
        pointer-events: none;
      }
      body::before {
        width: 600px; height: 600px;
        background: #FF6B4A;
        top: -200px; right: -150px;
      }
      body::after {
        width: 400px; height: 400px;
        background: #2DD4BF;
        bottom: -100px; left: -100px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1 class="logo">Balance <span>Atlas</span></h1>
      <p class="tagline">Coming soon.</p>
      <div class="dot"></div>
    </div>
  </body>
</html>
