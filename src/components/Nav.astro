---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/community', label: 'Community' },
  { href: '/retreats', label: 'Retreats' },
  { href: '/handstand-life', label: 'Handstand Life' },
  { href: '/contribute', label: 'Contribute' },
];

// /coaches/* paths should highlight "Community"
const isCoachesPath = currentPath.startsWith('/coaches');
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-sand/80 backdrop-blur-lg border-b border-navy/5">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group">
      <span class="text-2xl rotate-180 inline-block group-hover:scale-110 transition-transform">🤸</span>
      <span class="font-heading font-bold text-xl text-navy tracking-tight">
        Balance Atlas
      </span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-1">
      {links.map(({ href, label }) => {
        const isActive = currentPath === href
          || (href !== '/' && currentPath.startsWith(href))
          || (href === '/community' && isCoachesPath);
        return (
          <a
            href={href}
            class:list={[
              'px-4 py-2 rounded-full text-sm font-medium transition-all duration-200',
              isActive
                ? 'bg-coral text-white'
                : 'text-navy/70 hover:text-navy hover:bg-navy/5',
            ]}
          >
            {label}
          </a>
        );
      })}
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 rounded-lg hover:bg-navy/5 transition-colors"
      aria-label="Open menu"
    >
      <svg class="w-6 h-6 text-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-sand/95 backdrop-blur-lg border-b border-navy/5"
  >
    <div class="px-6 py-4 flex flex-col gap-1">
      {links.map(({ href, label }) => {
        const isActive = currentPath === href
          || (href !== '/' && currentPath.startsWith(href))
          || (href === '/community' && isCoachesPath);
        return (
          <a
            href={href}
            class:list={[
              'px-4 py-3 rounded-xl text-base font-medium transition-colors',
              isActive
                ? 'bg-coral text-white'
                : 'text-navy/70 hover:bg-navy/5',
            ]}
          >
            {label}
          </a>
        );
      })}
    </div>
  </div>
</nav>

<div class="h-16"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
