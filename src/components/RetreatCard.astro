---
interface Props {
  title: string;
  slug: string;
  status: 'upcoming' | 'past';
  coaches: string[];
  city: string;
  country: string;
  venue?: string;
  dateStart: Date;
  dateEnd: Date;
  level: string[];
  type: string;
  heroImage?: string;
  description?: string;
  registrationUrl?: string;
  index?: number;
}

const {
  title,
  slug,
  status,
  coaches,
  city,
  country,
  venue,
  dateStart,
  dateEnd,
  level,
  type,
  heroImage,
  description,
  registrationUrl,
  index = 0,
} = Astro.props;

const isUpcoming = status === 'upcoming';

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

const dateRange = `${formatDate(dateStart)} – ${formatDate(dateEnd)}, ${dateEnd.getFullYear()}`;

const levelColors: Record<string, string> = {
  beginner: 'bg-teal/15 text-teal-dark',
  intermediate: 'bg-coral/15 text-coral-dark',
  advanced: 'bg-navy/10 text-navy',
};
---

<a
  href={`/retreats/${slug}`}
  class="group block rounded-2xl overflow-hidden bg-white shadow-sm hover:shadow-xl
         transition-all duration-500 hover:-translate-y-1"
  data-animate
  data-animate-delay={String(index * 100)}
  style="opacity: 0; transform: translateY(24px);"
>
  <!-- Image -->
  <div class="relative aspect-[16/10] overflow-hidden">
    {heroImage ? (
      <img
        src={heroImage}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-coral/20 to-teal/20 flex items-center justify-center">
        <span class="text-6xl opacity-30">🤸</span>
      </div>
    )}

    {isUpcoming && (
      <div class="absolute top-3 right-3 bg-coral text-white text-xs font-semibold px-3 py-1 rounded-full shadow-lg">
        Upcoming
      </div>
    )}

    <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-black/40 to-transparent" />
    <div class="absolute bottom-3 left-4 text-white">
      <div class="text-xs font-medium opacity-90">{dateRange}</div>
    </div>
  </div>

  <!-- Content -->
  <div class="p-5">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-heading font-bold text-lg text-navy leading-tight group-hover:text-coral transition-colors">
        {title}
      </h3>
      <span class="shrink-0 text-xs font-medium uppercase tracking-wider text-navy/40 bg-navy/5 px-2 py-0.5 rounded-full">
        {type}
      </span>
    </div>

    <p class="mt-2 text-sm text-navy/60 flex items-center gap-1">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      {venue ? `${venue}, ${city}, ${country}` : `${city}, ${country}`}
    </p>

    {description && (
      <p class="mt-2 text-sm text-navy/50 line-clamp-2">{description}</p>
    )}

    <div class="mt-3 flex items-center gap-4">
      <div class="flex flex-wrap gap-1.5">
        {level.map((l) => (
          <span class={`text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full ${levelColors[l] ?? 'bg-navy/5 text-navy/60'}`}>
            {l}
          </span>
        ))}
      </div>
    </div>

    <div class="mt-3 text-xs text-navy/40">
      {coaches.map((c, i) => (
        <span>
          {i > 0 && ', '}
          {c.replace(/-/g, ' ').replace(/\b\w/g, (l) => l.toUpperCase())}
        </span>
      ))}
    </div>
  </div>
</a>

<style>
  [data-animate].is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
</style>
