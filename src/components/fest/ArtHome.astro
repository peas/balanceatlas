---
import FestLayout from '../../layouts/FestLayout.astro';
import HFSelo from './HFSelo.astro';
import ArtGesture from './ArtGesture.astro';
import ArtStoryPlayer from '../../festival/ArtStoryPlayer';
import { FEST, QUANDO, VENDA, SYMPLA_NO_AR, SYMPLA, faqFest } from '../../festival/data';
import { LOTES, VAGAS, MAPS_PLACE, days, lineup } from '../../festival/home-content';
interface Props { theme: string }
const {theme='misto'}=Astro.props;
const styles=[{id:'ocre',name:'Creme + ocre',url:'/festival/home2/ocre/'},{id:'verde',name:'Verde + ocre',url:'/festival/home2/verde/'}];
const rowTitle = (row: (typeof days)[number]['rows'][number]) => 'all' in row ? row.all : '';
const teachers=lineup.map(t=>({name:`${t.poster.first} ${t.poster.last}`.trim(),img:t.poster.img,focus:t.poster.focus,url:t.url,handle:t.poster.handle}));
---
<FestLayout stickyNav={false} title={`HandstandFest · Home arte / ${theme}`}>
  <main class:list={['art-home',`theme-${theme}`]}>
    <div class="study-bar"><span>OUTRA FORMA DE VER O FESTIVAL</span><nav aria-label="Comparar estilos da home">{styles.map(s=><a href={s.url} aria-current={s.id===(theme==='verde'?'verde':'ocre')?'page':undefined}>{s.name}</a>)}<a class="original" href="/festival/">Home atual ↗</a></nav></div>
    <header class="art-header">
      <nav class="art-nav art-wrap" aria-label="Navegação do festival">
        <a href="#inicio" class="art-brand" aria-label="HandstandFest, início"><HFSelo tom={theme==='verde'?'amarelo':'verde'} simples/><span>HANDSTAND<br/>FEST</span></a>
        <div class="art-nav-links"><a href="#encontro">O encontro</a><a href="#professores">Professores</a><a href="#programa">Programação</a></div>
        <a class="art-button nav-ticket" href="#ingressos">Ingressos <span>↗</span></a>
      </nav>
      <div class="art-wrap art-hero" id="inicio">
        <div class="hero-copy"><p class="art-eyebrow">1º FESTIVAL DE PARADA DE MÃO · SÃO PAULO</p><h1>HAND<br/>STAND<br/><span>FEST.</span></h1><p class="hero-date">{QUANDO}<br/><span>Trapézio Voador · Butantã</span></p><div class="hero-cta"><a class="art-button" href="#ingressos">Vem treinar junto <span>↗</span></a><span class="ticket-note">1º lote · R$ {VENDA.preco} + taxa<br/><span data-venda="Vendas abertas">Abre {VENDA.dia}</span></span></div></div>
        <figure class:list={['hero-art', {'hero-engraving': theme === 'ocre'}]}>
          {theme === 'ocre' ? <><ArtGesture pose="stag"/><figcaption>O CORPO DESENHA. O ENCONTRO CONTINUA.</figcaption></> : <><ArtStoryPlayer client:visible mode="event"/><figcaption>O ENCONTRO · OS PROFESSORES · A PRÁTICA</figcaption></>}
        </figure>
      </div>
      <div class="hero-bottom art-wrap"><span>3 dias para praticar, explorar e se encontrar.</span><a href="#encontro">Conheça o festival <span>↓</span></a></div>
    </header>

    <section class="art-wrap meeting" id="encontro">
      <div class="meeting-intro"><p class="art-eyebrow">01 / O ENCONTRO</p><h2>De cabeça<br/>para baixo.<br/><em>De portas<br/>abertas.</em></h2><p>A primeira edição é para quem pratica parada de mão por ela mesma: quem chegou pela calistenia, pelo yoga, pela dança, pelo movimento ou só pela teimosia de ficar de cabeça para baixo.</p><a class="text-link" href="/festival/sobre/">Conheça a ideia do festival ↗</a></div>
      <figure class="practice-film"><div class="film-frame"><video controls playsinline muted loop preload="none" poster="/festival/ig/arte/formas-poster.webp" aria-label="Treino de handstand na sala de vidro do Trapézio Voador"><source src="/festival/ig/ig2-formas.mp4" type="video/mp4"/></video></div><figcaption><span>O TREINO. AS FORMAS. A TROCA.</span><span>TRAPÉZIO VOADOR / SÃO PAULO</span></figcaption></figure>
      <div class="meeting-note"><div class="note-engraving"><ArtGesture pose="straddle"/></div><p><strong>Três dias treinando, conversando e aprendendo parada de mão.</strong> Yoga junto, parada de mão na sua turma, uma aula de tema à tarde e, no fim do dia, aula ou jam com os professores.</p></div>
    </section>

    <section class="art-teachers" id="professores"><div class="art-wrap">
      <div class="art-section-head"><div><p class="art-eyebrow">02 / QUEM VEM JUNTO</p><h2>Outros olhares.<br/>Novos caminhos.</h2></div><p>Professores de especialidades diferentes, no mesmo fim de semana. Cada turma tem também professores assistentes.</p></div>
      <div class="teacher-feature"><ArtStoryPlayer client:visible mode="teachers"/><div><p class="art-eyebrow">PROFESSORES</p><h3>Quem vem<br/>junto.</h3><p>Acompanhe os stories e conheça o trabalho dos professores.</p><div class="teacher-profile-links">{teachers.map(t=><a class="text-link" href={t.url} target="_blank" rel="noopener">{t.name} ↗</a>)}</div></div></div>
      <div class="portrait-grid">{teachers.map((t,i)=><article><div class:list={['portrait',{bw:i%2===0}]}><img src={t.img} alt={t.name} style={`object-position:${t.focus}`} loading="lazy" width="600" height="800"/></div><h3><span>{t.name}</span></h3><a href={t.url} target="_blank" rel="noopener">{t.handle} ↗</a></article>)}</div>
      <p class="more-teachers">Mais nomes em breve.</p>
    </div></section>

    <section class="art-wrap program" id="programa">
      <div class="art-section-head"><div><p class="art-eyebrow">03 / O RITMO DOS DIAS</p><h2>Base.<br/>Construção.<br/><em>Integração.</em></h2></div><p>Do básico ao avançado, com quatro blocos por dia. A grade é provisória e ainda está sendo ajustada com os professores.</p></div>
      <div class="program-days">{days.map(d=><article><div class="day-top"><span>{d.label} / {d.date} {FEST.mesCurto}</span><h3>{d.arc}</h3></div><div class="day-summary"><p>{rowTitle(d.rows[0])}</p><p>Parada de mão na sua turma</p><p>{d.id==='sex'?'Acroyoga':d.id==='sab'?'Acro handstand corpo a corpo':'Handstand em objetos'}<br/><span>ou flexibilidade e força para press</span></p>{rowTitle(d.rows[d.rows.length-1]) && <p>{rowTitle(d.rows[d.rows.length-1])}</p>}</div><details><summary>Ver horários e turmas <span>+</span></summary><dl>{d.rows.map(row=><div><dt>{row.time}</dt><dd>{'all' in row?row.all: <><span><b>Básico:</b> {row.tracks[0].t}</span><span><b>Intermediário e avançado:</b> {row.tracks[1].t}</span></>}</dd></div>)}</dl></details></article>)}</div>
      <div class="levels-note"><div><h3>Ainda na parede?</h3><p>A turma de básico começa daí: linha, chute, saída segura e primeiros segundos no livre.</p></div><div><h3>Já segura o livre?</h3><p>Intermediário e avançado: 10 segundos com consistência, 30 é o ideal. Formas, press e one arm.</p></div></div>
    </section>

    <section class="art-place" id="local"><div class="art-wrap place-grid"><figure><img src="/festival/ig/tv-sala-vidro.webp" width="1000" height="750" loading="lazy" alt="Sala de vidro do Trapézio Voador, com luz natural e piso de madeira"/><figcaption>ESPAÇO PARA MOVER. TEMPO PARA EXPLORAR.</figcaption></figure><div><p class="art-eyebrow">04 / A NOSSA CASA POR TRÊS DIAS</p><h2>Trapézio<br/><em>Voador.</em></h2><p>R. Alvarenga, 150<br/>Jardim Guedala · São Paulo</p><p>Perto da Estação Butantã do metrô.</p><a class="text-link" href={MAPS_PLACE} target="_blank" rel="noopener">Como chegar ↗</a><a class="venue-source" href="https://trapeziovoador.com.br/" target="_blank" rel="noopener">Conheça o espaço ↗</a></div></div></section>

    <section class="art-tickets" id="ingressos"><div class="art-wrap"><div class="art-section-head"><div><p class="art-eyebrow">05 / RESERVE ESSES DIAS</p><h2>Seu lugar<br/>nessa <em>roda.</em></h2></div><div class="ticket-seal"><HFSelo tom="amarelo"/><p>{QUANDO}<br/>SÃO PAULO</p></div></div><div class="art-prices">{LOTES.map((l,i)=><article class:list={{first:i===0}}><p>{l.n}<span>{i===0?<span data-venda="Aberto">Abre {VENDA.dia}</span>:'Na sequência'}</span></p><h3><small>R$</small>{l.price}</h3><p>{l.note}</p></article>)}</div><div class="buy-row"><div><p>Passe completo para os 3 dias · {VAGAS} vagas no total.</p><p class="fee-note">Taxa do Sympla à parte: R$ {VENDA.taxa} no 1º lote. Parcelamento em até 12 vezes.</p></div>{SYMPLA_NO_AR?<a class="art-button" href={SYMPLA} target="_blank" rel="noopener">Garantir minha vaga ↗</a>:<p class="sales-note"><strong>Vendas a partir de {VENDA.dia}</strong><span>O link de inscrição será disponibilizado aqui.</span></p>}</div></div></section>

    <section class="art-wrap art-faq"><p class="art-eyebrow">ANTES DE VIR</p><h2>Vamos conversar?</h2><div>{faqFest.filter((_,i)=>[0,2,3,6].includes(i)).map(f=><details><summary>{f.q}<span>+</span></summary><p>{f.a}</p></details>)}</div><a class="text-link" href="/festival/sobre/#perguntas">Mais sobre o encontro ↗</a></section>
  </main>
</FestLayout>
<style>
.hero-engraving{width:100%}
:global(html:has(.art-home)){scroll-behavior:auto}
.art-home{overflow-x:clip;--art-paper:#f3eddf;--art-ink:#22332a;--art-paint:#cb8b34;--art-green:#153d32;--art-yellow:#dfab5b;background:var(--art-paper);color:var(--art-ink)}
.art-home.theme-amarelo{--art-paint:#ffd23f}.art-home.theme-verde{--art-paint:#dfab5b}.art-wrap{width:min(1180px,100% - 2 * var(--gutter));margin-inline:auto}.art-home a{text-underline-offset:5px}.art-home :is(a,summary):focus-visible{outline:3px solid currentColor;outline-offset:5px}.art-home [id]{scroll-margin-top:24px}
.study-bar{display:flex;justify-content:space-between;gap:14px;align-items:center;padding:10px var(--gutter);background:#e9e3d5;color:#37463d;font:10px var(--mono)}.study-bar nav{display:flex;align-items:center;gap:6px}.study-bar a{padding:6px 12px;text-decoration:none}.study-bar a[aria-current]{background:#22332a;color:#f3eddf}.study-bar .original{margin-left:12px;text-decoration:underline}
.art-header{padding-bottom:0}.art-nav{display:flex;align-items:center;justify-content:space-between;gap:25px;padding-block:24px}.art-brand{display:flex;align-items:center;gap:12px;font:900 12px/.95 var(--display);text-decoration:none;letter-spacing:-.4px}.art-brand :global(.selo){width:52px;height:52px}.art-brand :global(img){width:100%;height:100%}.art-nav-links{display:flex;gap:30px;font-size:13px}.art-nav-links a{text-decoration:none}.art-nav-links a:hover{text-decoration:underline}
.art-button{display:inline-flex;align-items:center;justify-content:space-between;gap:26px;padding:18px 24px;text-decoration:none;font-weight:700;background:var(--art-ink);color:var(--art-paper);font-size:14px;transition:transform .2s}.art-button:hover{transform:translateY(-2px)}.nav-ticket{padding:12px 18px;font-size:12px}.art-eyebrow{font:700 10px/1.6 var(--mono);letter-spacing:.12em;margin-bottom:22px}.art-hero{display:grid;grid-template-columns:1.05fr 1fr;align-items:center;gap:30px;padding-block:35px 50px}.hero-copy{position:relative;z-index:2;align-self:start;padding-top:35px}.hero-copy h1{font:900 clamp(70px,8vw,114px)/.83 var(--display);font-stretch:125%;letter-spacing:-.055em;margin:32px 0}.hero-copy h1 span{color:#9b6524}.theme-amarelo .hero-copy h1 span{color:var(--art-ink)}.hero-date{font:700 clamp(16px,1.9vw,22px)/1.65 var(--mono);text-transform:uppercase}.hero-date>span{font:400 16px var(--body);text-transform:none}.hero-cta{display:flex;align-items:center;gap:24px;margin-top:30px}.ticket-note{font:12px/1.6 var(--mono)}.hero-art{margin:0;position:relative;align-self:center;max-width:440px;justify-self:end}.hero-art figcaption{font:9px var(--mono);letter-spacing:.12em;margin-top:28px;text-align:center}.hero-bottom{display:flex;justify-content:space-between;gap:30px;border-top:1px solid #a8afa0;padding-block:23px;font-size:13px}.hero-bottom a{text-decoration:none}.hero-bottom a span{margin-left:20px}
.theme-verde .art-header{background:var(--art-green);color:var(--art-paper);--art-ink:var(--art-paper)}.theme-verde .hero-copy h1 span{color:var(--art-yellow)}.theme-verde .art-header .art-button{background:var(--art-yellow);color:#153d32}.theme-verde .hero-art{transform:none}.theme-verde .hero-art :global(.art-disc){transform:scale(1.13) rotate(-22deg)}
.meeting{display:grid;grid-template-columns:1fr 1fr;gap:50px 80px;padding-block:110px}.art-home h2{font:900 clamp(36px,4.6vw,64px)/1.02 var(--display);font-stretch:125%;letter-spacing:-.055em}.art-home h2 em{font-style:normal;color:#976329}.meeting-intro{padding-top:20px}.meeting-intro>p:not(.art-eyebrow){max-width:36ch;font-size:17px;line-height:1.75;margin:30px 0}.text-link{display:inline-block;font-size:13px;font-weight:700;padding-bottom:6px}.practice-film{align-self:start}.film-frame{position:relative;aspect-ratio:3/4;background:#d9d4c7;isolation:isolate}.film-frame::before{content:'';position:absolute;z-index:-1;inset:10% -6% 25% -7%;background:var(--art-paint);mask:url('/festival/brand/stroke-v7.svg') center/100% 100% no-repeat;transform:rotate(-7deg)}.film-frame video{display:block;width:100%;height:100%;object-fit:contain}.practice-film figcaption{display:flex;justify-content:space-between;gap:15px;font:9px/1.7 var(--mono);margin-top:14px}.note-engraving{width:180px;justify-self:center}.teacher-feature{display:grid;grid-template-columns:minmax(0,.85fr) 1fr;gap:70px;align-items:center;margin:55px 0 75px}.teacher-feature h3{font:900 clamp(40px,5vw,64px)/1 var(--display);letter-spacing:-.04em;margin-bottom:25px}.teacher-feature p:not(.art-eyebrow){font-size:17px;line-height:1.8;margin-bottom:24px}.teacher-profile-links{display:flex;flex-direction:column;align-items:start;gap:14px}.teacher-feature small{display:block;font-size:12px;margin-top:16px}
.meeting-note{grid-column:1/-1;display:grid;grid-template-columns:.4fr 1fr;gap:50px;border-top:1px solid #a8afa0;padding-top:34px;align-items:center}.note-number{font:900 110px/1 var(--display);letter-spacing:-.1em;color:var(--art-paint)}.meeting-note p{max-width:62ch;font-size:18px;line-height:1.75}.meeting-note strong{font-weight:500}
.art-teachers{padding-block:95px;background:#e8e2d4}.art-section-head{display:flex;justify-content:space-between;align-items:end;gap:50px;margin-bottom:45px}.art-section-head>p{max-width:34ch;font-size:16px;line-height:1.7}.portrait-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.portrait{position:relative;aspect-ratio:3/4;isolation:isolate;margin:12px 4px 0;--portrait-paint:var(--art-paint)}.portrait::before{content:"";position:absolute;inset:-9px -8px -12px;z-index:-1;background:var(--portrait-paint);mask:url('/festival/brand/stroke-v7.svg') center/100% 100% no-repeat;transform:rotate(-2.5deg)}.portrait-grid article:nth-child(even) .portrait{--portrait-paint:var(--art-green)}.portrait-grid article:nth-child(even) .portrait::before{transform:rotate(2deg)}.portrait-grid article:nth-child(3) .portrait{--portrait-paint:#94744a}.theme-verde .portrait{--portrait-paint:var(--art-yellow)}.portrait img{width:100%;height:100%;object-fit:cover;filter:saturate(.7) contrast(.96)}.portrait.bw img{filter:grayscale(1) contrast(1.03)}.portrait span{position:absolute;bottom:10px;left:12px;font:12px var(--mono);background:var(--art-paper);color:var(--art-ink);padding:5px 8px}.portrait-grid h3 span{position:relative;isolation:isolate;box-decoration-break:clone;-webkit-box-decoration-break:clone}.portrait-grid h3 span::before{content:"";position:absolute;z-index:-1;inset:63% -5px -5px;background:var(--art-paint);opacity:.5;mask:url('/festival/brand/stroke-v7.svg') center/100% 100% no-repeat;transform:rotate(-1deg)}.portrait-grid h3{font:900 19px/1.1 var(--display);letter-spacing:-.6px;margin:26px 0 14px}.portrait-grid a{font:10px var(--mono)}.more-teachers{font:11px var(--mono);margin-top:30px}
.program{padding-block:100px}.program-days{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:35px}.program-days article{border-top:2px solid var(--art-ink)}.day-top{padding-block:20px}.day-top>span{font:11px var(--mono);text-transform:uppercase}.day-top h3{font:900 24px var(--display);letter-spacing:-1px;margin-top:9px}.day-summary{font-size:14px;line-height:1.6}.day-summary p{border-top:1px solid #c5c5b6;padding:13px 0}.day-summary span{font-size:12px}.art-home details{border-top:1px solid #a8afa0}.art-home summary{display:flex;justify-content:space-between;gap:16px;align-items:center;cursor:pointer;list-style:none;padding:18px 0;font-weight:700;font-size:13px}.art-home summary::-webkit-details-marker{display:none}.art-home details[open] summary>span{transform:rotate(45deg)}.program dl{font-size:12px;line-height:1.5}.program dl>div{padding:12px 0;border-top:1px solid #cdcabc}.program dt{font:700 11px var(--mono);margin-bottom:7px}.program dd span{display:block;margin-top:6px}.levels-note{display:grid;grid-template-columns:1fr 1fr;gap:60px;border-top:1px solid #a8afa0;margin-top:50px;padding-top:30px}.levels-note h3{font-size:20px;margin-bottom:12px}.levels-note p{max-width:42ch;line-height:1.7;font-size:15px}
.art-place{padding-block:90px;background:#e8e2d4}.place-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:70px;align-items:center}.place-grid img{display:block;width:100%;height:auto;filter:grayscale(1) contrast(.95)}.place-grid figcaption{font:9px var(--mono);margin-top:18px;letter-spacing:.1em}.place-grid h2{margin-bottom:30px}.place-grid p:not(.art-eyebrow){font-size:16px;margin-bottom:18px}.venue-source{display:block;font-size:11px;margin-top:16px}
.art-tickets{background:var(--art-green);color:var(--art-paper);padding-block:90px}.art-tickets h2 em{color:var(--art-yellow)}.ticket-seal{display:flex;align-items:center;gap:24px}.ticket-seal :global(.selo){width:100px;height:100px}.ticket-seal :global(img){width:100%;height:100%}.ticket-seal p{font:11px/1.8 var(--mono)}.art-prices{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px}.art-prices article{min-width:0;padding:24px 0;border-top:1px solid #7a9482}.art-prices article>p:first-child{display:flex;justify-content:space-between;gap:16px;font:12px var(--mono)}.art-prices article>p:first-child>span{font-size:10px}.art-prices h3{font:900 clamp(40px,5.5vw,68px) var(--display);letter-spacing:-3px;margin:12px 0}.art-prices h3 small{font:14px var(--mono);letter-spacing:0;margin-right:10px}.art-prices .first h3{color:var(--art-yellow)}.art-prices article>p:last-child{font-size:13px}.buy-row{display:flex;justify-content:space-between;gap:40px;align-items:start;border-top:1px solid #7a9482;padding-top:28px;margin-top:15px}.buy-row p{font-size:14px}.buy-row .fee-note{font-size:11px;margin-top:8px;max-width:52ch;opacity:.85}.buy-row .art-button{background:var(--art-yellow);color:var(--art-green)}.sales-note span{display:block;font-size:11px;margin-top:5px}.sales-note strong{font-size:14px}
.theme-amarelo .art-tickets{background:var(--art-yellow);color:var(--art-ink)}.theme-amarelo .art-tickets h2 em,.theme-amarelo .art-prices .first h3{color:var(--art-ink)}
.art-faq{padding-block:90px}.art-faq h2{margin-bottom:35px}.art-faq>div{max-width:850px}.art-faq details summary{font-size:17px;padding-block:21px}.art-faq details p{max-width:70ch;font-size:16px;line-height:1.7;padding-bottom:25px}.art-faq>.text-link{margin-top:24px}
